# Database
DB_ROOT_PASSWORD=password
DB_USERNAME=root
DB_PASSWORD=your_db_password_here

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_JWK_URI=http://keycloak:8080/realms/agricontract/protocol/openid-connect/certs
# Public realm URL the frontend logs in through; the gateway rejects tokens whose iss differs.
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/agricontract
# Secret of the Keycloak client user-service (marks emails verified, deletes unverified accounts). Generate: openssl rand -hex 32
KEYCLOAK_USER_SERVICE_SECRET=REPLACE_WITH_RANDOM_SECRET

# RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# Internal trust — Gateway <-> downstream services (generate: openssl rand -hex 32 — do NOT use a literal/example value)
GATEWAY_INTERNAL_SECRET=REPLACE_WITH_RANDOM_SECRET
# Internal trust — service <-> service (Feign) (generate: openssl rand -hex 32 — do NOT use a literal/example value)
SERVICE_INTERNAL_SECRET=REPLACE_WITH_RANDOM_SECRET

# Contract signing OTP and email verification peppers. Compose requires both and has no defaults.
# Generate a separate value for each with openssl rand -hex 32.
OTP_PEPPER=REPLACE_WITH_RANDOM_SECRET
EMAIL_VERIFICATION_PEPPER=REPLACE_WITH_RANDOM_SECRET

# Email intake of file-service (#275): the IMAP login of the intake@ mailbox, also the user compose's GreenMail
# creates. No default: compose refuses to start without them. Generate the password: openssl rand -hex 32
INTAKE_IMAP_USERNAME=intake
INTAKE_IMAP_PASSWORD=REPLACE_WITH_RANDOM_SECRET

# Mail (MailHog for dev)
MAIL_HOST=mailhog
MAIL_PORT=1025

# Operator address of notification-service's staff alerts (Level 1.5 inspection waiting for an inspector, D49).
# Compose defaults to operator@agricontract.local (MailHog); set the real Operator mailbox outside dev.
OPERATOR_EMAIL=

# Inspection: report file downloads from File Service.
# Set false only as an operational fallback when File Service downloads must be disabled.
INSPECTION_FILE_DOWNLOAD_ENABLED=true

# Vietnam business-day calendar (shared/java-business-calendar, #295). Comma-separated YYYY-MM-DD public holidays of
# the operating years; Monday-Friday except these dates are business days. Update every year from the official
# announcement (Tết dates move). Missing, blank or invalid values stop the services that use it at startup.
VIETNAM_HOLIDAYS=
