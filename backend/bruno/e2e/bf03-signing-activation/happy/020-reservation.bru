meta {
  name: BF03-020 Confirm listing quantity is reserved
  type: http
  seq: 20
}

get {
  url: {{base_url}}/api/v1/listings/{{listing_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{buyer_token}}
}

tests {
  test("status and response contract", () => {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().quantityAvailable).to.equal(bru.getVar('available_before_offer') - 1000);
  });
}

