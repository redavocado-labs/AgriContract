meta {
  name: BF04-130 Record seller weight
  type: http
  seq: 30
}

post {
  url: {{base_url}}/api/v1/contracts/{{contract_id}}/milestones/{{milestone_id}}/weigh
  body: json
  auth: bearer
}

auth:bearer {
  token: {{seller_token}}
}

headers {
  Idempotency-Key: {{action_key}}
}

body:json {
  {
    "sellerDeclaredWeight": 1000,
    "sellerEvidenceFileId": "{{evidence_id}}",
    "consent": {
      "statementVersion": "1.0",
      "presentedContentHash": "{{consent_hash}}"
    }
  }
}

script:pre-request {
  const { consent, milestoneState } = require('./e2e/milestone.js');
  const file = bru.getVar('evidence_id');
  await milestoneState(bru, (data) => data.evidence?.some((item) => item.fileId === file && item.status === 'READY'),
    'ready evidence ' + file);
  bru.setVar('action_key', require('crypto').randomUUID());
  bru.setVar('consent_hash', consent('DECLARE_SELLER_WEIGHT', [bru.getVar('milestone_id'), '1000.000', file, '']).presentedContentHash);
}

tests {
  test("status and response contract", () => {
    expect(res.getStatus()).to.equal(204);
    expect([null, undefined, '']).to.include(res.getBody());
  });
}

docs {
  IT-GW

  OpenAPI milestone weigh and D84 canonical consent.
}
