meta {
  name: BF04-350 Check anchor queue topology and empty DLQ
  type: http
  seq: 50
}

get {
  url: {{rabbitmq_management_url}}/api/queues
  body: none
  auth: none
}

headers {
  Authorization: Basic {{rabbitmq_basic}}
}

script:pre-request {
  const { variable } = require('./e2e/helpers.js');
  bru.setVar('rabbitmq_basic', Buffer.from(variable(bru, 'rabbitmq_username') + ':' + variable(bru, 'rabbitmq_password')).toString('base64'));
}

tests {
  test("status and response contract", () => {
    expect(res.getStatus()).to.equal(200);
    const queues = res.getBody();
    expect(queues.some((queue) => queue.name === 'notification-svc.notification.milestone_anchor_requested')).to.equal(true);
    expect(queues.find((queue) => queue.name === 'notification-svc.notification.milestone_anchor_requested.dlq')?.messages).to.equal(0);
    expect(queues.some((queue) => queue.name.endsWith('.milestone.flagged'))).to.equal(false);
  });
}

docs {
  IT-DIRECT

  RabbitMQ management readonly query. Notification topology (#632), notification-commands.yaml and D101.
}
