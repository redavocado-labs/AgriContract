meta {
  name: GET /api/v1/contracts (protected, with token)
  type: http
  seq: 4
}

get {
  url: {{base_url}}/api/v1/contracts
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("should return 200 with a valid token", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("body is a page of contracts", function() {
    expect(res.getBody().content).to.be.an("array");
    expect(res.getBody().totalElements).to.be.a("number");
  });
}
