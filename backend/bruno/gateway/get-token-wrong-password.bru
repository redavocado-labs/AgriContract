meta {
  name: Get Token (buyer1, wrong password → 401)
  type: http
  seq: 5
}

post {
  url: {{keycloak_url}}/realms/{{realm}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: password
  client_id: {{client_id}}
  username: {{buyer_username}}
  password: wrong-{{buyer_password}}
}

tests {
  test("should return 401", function() {
    expect(res.getStatus()).to.equal(401);
  });

  test("invalid_grant and no access_token", function() {
    expect(res.getBody().error).to.equal("invalid_grant");
    expect(res.getBody().access_token).to.equal(undefined);
  });
}
