meta {
  name: SEC-100 Admin verifies the global audit chain
  type: http
  seq: 100
}

get {
  url: {{base_url}}/api/v1/admin/audit/verification
  body: none
  auth: bearer
}

auth:bearer {
  token: {{admin_token}}
}

script:pre-request {
  const { token } = require('./e2e/helpers.js');
  await token(bru, 'admin');
}

tests {
  test("status and response contract", () => {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.include({ scope: 'GLOBAL', status: 'INTACT', contractId: null });
    expect(res.getBody().checkedRecords).to.be.a('number');
  });
}

docs {
  IT-GW

  OpenAPI verifyGlobalAuditChain and hash-chain design §4.6.
}
