meta {
  name: POST /api/v1/products (cropYear 1999, outside 2000..2100 → 400)
  type: http
  seq: 12
}

post {
  url: {{product_service_url}}/api/v1/products
  body: json
  auth: none
}

headers {
  X-Gateway-Secret: {{gateway_secret}}
  X-User-Id: {{seller1_sub}}
  X-User-Role: SELLER
}

body:json {
  {
    "name": "Ca phe Robusta (cropYear 1999)",
    "unit": "kg",
    "categoryId": "{{category_id}}",
    "imageUrls": [
      "https://cdn.agricontract.test/products/ca-phe-robusta-1.jpg"
    ],
    "cropYear": 1999
  }
}

tests {
  test("should return 400", function() {
    expect(res.getStatus()).to.equal(400);
  });

  test("error code is VALIDATION_FAILED", function() {
    expect(res.getBody().code).to.equal("VALIDATION_FAILED");
    expect(res.getBody().traceId).to.be.a("string");
  });
}
