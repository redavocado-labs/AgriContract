meta {
  name: PUT /api/v1/products/:productId/images (6 images, max + 1 → 400)
  type: http
  seq: 36
}

put {
  url: {{product_service_url}}/api/v1/products/{{product_id}}/images
  body: json
  auth: none
}

headers {
  X-Gateway-Secret: {{gateway_secret}}
  X-User-Id: {{seller1_sub}}
  X-User-Role: SELLER
}

body:json {
  {
    "imageUrls": [
      "https://cdn.agricontract.test/products/ca-phe-robusta-1.jpg",
      "https://cdn.agricontract.test/products/ca-phe-robusta-2.jpg",
      "https://cdn.agricontract.test/products/ca-phe-robusta-3.jpg",
      "https://cdn.agricontract.test/products/ca-phe-robusta-4.jpg",
      "https://cdn.agricontract.test/products/ca-phe-robusta-5.jpg",
      "https://cdn.agricontract.test/products/ca-phe-robusta-6.jpg"
    ]
  }
}

tests {
  test("should return 400", function() {
    expect(res.getStatus()).to.equal(400);
  });

  test("error code is VALIDATION_FAILED", function() {
    expect(res.getBody().code).to.equal("VALIDATION_FAILED");
    expect(res.getBody().traceId).to.be.a("string");
  });
}
