meta {
  name: POST /api/v1/categories (blank name → 400)
  type: http
  seq: 1
}

post {
  url: {{product_service_url}}/api/v1/categories
  body: json
  auth: none
}

headers {
  X-Gateway-Secret: {{gateway_secret}}
  X-User-Id: {{seller1_sub}}
  X-User-Role: SELLER
}

body:json {
  {
    "name": ""
  }
}

tests {
  test("should return 400", function() {
    expect(res.getStatus()).to.equal(400);
  });

  test("error code is VALIDATION_FAILED", function() {
    expect(res.getBody().code).to.equal("VALIDATION_FAILED");
    expect(res.getBody().traceId).to.be.a("string");
  });
}
