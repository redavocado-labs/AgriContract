meta {
  name: SEC-110 Operator role is denied global verification
  type: http
  seq: 110
}

get {
  url: {{base_url}}/api/v1/admin/audit/verification
  body: none
  auth: bearer
}

auth:bearer {
  token: {{operator_token}}
}

script:pre-request {
  const { token } = require('./e2e/helpers.js');
  await token(bru, 'operator');
}

tests {
  test("status and response contract", () => {
    expect(res.getStatus()).to.equal(403);
    expect(res.getBody()).to.be.an('object');
    expect(res.getBody().code).to.be.a('string');
    expect(res.getBody()).not.to.have.property('checkedRecords');
  });
}

