meta {
  name: SEC-064 ARBITRATOR reads arbitration queue
  type: http
  seq: 64
}

get {
  url: {{base_url}}/api/v1/arbitration/breach-cases?size=10
  body: none
  auth: bearer
}

auth:bearer {
  token: {{arbitrator_token}}
}

script:pre-request {
  const { token } = require('./e2e/helpers.js');
  await token(bru, 'arbitrator');
}

tests {
  test("status and response contract", () => {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().content).to.be.an('array');
    expect(res.getBody().totalElements).to.be.a('number');
  });
}

