meta {
  name: SEC-040 BUYER reads kyc queue
  type: http
  seq: 40
}

get {
  url: {{base_url}}/api/v1/admin/users?verificationStatus=PENDING
  body: none
  auth: bearer
}

auth:bearer {
  token: {{buyer_token}}
}

script:pre-request {
  const { token } = require('./e2e/helpers.js');
  await token(bru, 'buyer');
}

tests {
  test("status and response contract", () => {
    expect(res.getStatus()).to.equal(403);
    expect(res.getBody()).to.be.an('object');
    expect(res.getBody().code).to.be.a('string');
    expect(res.getBody()).not.to.have.property('content');
  });
}

docs {
