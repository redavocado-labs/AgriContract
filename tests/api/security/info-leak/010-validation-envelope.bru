meta {
  name: SEC-190 Validation errors omit system internals
  type: http
  seq: 10
}

get {
  url: {{base_url}}/api/v1/contracts?page=-1
  body: none
  auth: bearer
}

auth:bearer {
  token: {{buyer_token}}
}

script:pre-request {
  const { token } = require('./e2e/helpers.js');
  await token(bru, 'buyer');
}

tests {
  test("status and response contract", () => {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().code).to.be.a('string');
    expect(JSON.stringify(res.getBody())).not.to.match(/SQLException|org\.springframework|\bat [\w.$]+\(|\/app\//i);
  });
}

