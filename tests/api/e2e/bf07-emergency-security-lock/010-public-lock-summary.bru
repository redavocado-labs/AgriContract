meta {
  name: BF07-010 Read a fixture account lock summary
  type: http
  seq: 10
}

get {
  url: {{base_url}}/api/v1/reputation/{{buyer1_sub}}/public-summary
  body: none
  auth: bearer
}

auth:bearer {
  token: {{seller_token}}
}

script:pre-request {
  const { token } = require('./e2e/helpers.js');
  await token(bru, 'seller');
}

tests {
  test("status and response contract", () => {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().locked).to.equal(false);
    expect(res.getBody().lockHistory).to.be.an('array');
    const { total, unsuccessful } = res.getBody().flagOutcome;
    expect(total).to.be.a('number').and.to.be.at.least(0);
    expect(unsuccessful).to.be.a('number').and.to.be.within(0, total);
  });
}

docs {
  IT-GW

  OpenAPI getPublicReputationSummary and reputation-service design §6.1b. Runs as the seller against the seeded buyer.
}
