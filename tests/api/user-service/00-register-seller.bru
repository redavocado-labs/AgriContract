meta {
  name: POST /api/v1/users/register (201 first time, 200 when the seed already has the profile)
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/users/register
  body: json
  auth: bearer
}

auth:bearer {
  token: {{seller_token}}
}

body:json {
  {
    "organizationName": "Nong Trai ABC",
    "email": "{{seller1_email}}",
    "phone": "0901234567",
    "address": "Ha Noi"
  }
}

script:post-response {
  const userId = res.getBody()?.userId;
  if (userId) {
    bru.setEnvVar("registered_user_id", userId);
  }
}

tests {
  // backend/scripts/seed/02-user-db.sql seeds seller1's profile (VERIFIED), so after run-e2e.sh this call
  // finds it and returns 200; 201 with a PENDING profile only when the seeded row was removed first.
  test("should return 201 on first registration or 200 when the profile exists", function() {
    expect([200, 201]).to.include(res.getStatus());
  });

  test("body is not wrapped in ApiResponse", function() {
    expect(res.getBody().data).to.equal(undefined);
  });

  test("userId is seller1's Keycloak sub", function() {
    expect(res.getBody().userId).to.equal(bru.getEnvVar("seller1_sub"));
  });

  test("role should be SELLER", function() {
    expect(res.getBody().role).to.equal("SELLER");
  });

  test("a new profile starts PENDING", function() {
    if (res.getStatus() === 201) {
      expect(res.getBody().verificationStatus).to.equal("PENDING");
    }
  });
}
