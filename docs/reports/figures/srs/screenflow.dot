digraph ScreenFlow {
  rankdir=TB; bgcolor="white"; nodesep=0.22; ranksep=0.42; fontname="Arial"; pad=0.15;
  node [fontname="Arial", shape=box, style="rounded,filled", fillcolor="white", color="black", fontsize=12, margin="0.13,0.09"];
  edge [fontname="Arial", fontsize=10, color="#333333", arrowsize=0.7];
  subgraph cluster_public {
    label="Public / Identity Provider"; labeljust=l; style=filled; fillcolor="#f2f2f2"; color="#888888";
    RegisterAccount [label="Register Account\n(Buyer / Seller)"]; Login; ForgotPassword [label="Forgot Password"]; UpdatePassword [label="Update Password\n(valid reset link)"];
    BrowseListings [label=<<B>Browse Listings</B>>,penwidth=2]; ListingDetail [label="Listing Detail"]; MarketPriceBoard [label=<<B>Market Price Board</B>>,penwidth=2];
    {rank=same; RegisterAccount; Login; ForgotPassword; UpdatePassword;}
    {rank=same; BrowseListings; ListingDetail; MarketPriceBoard;}
    Login -> ForgotPassword; ForgotPassword -> UpdatePassword [label="email link"]; UpdatePassword -> Login [constraint=false]; BrowseListings -> ListingDetail;
    RegisterAccount -> BrowseListings [style=invis];
  }
  subgraph cluster_auth {
    label="Authenticated account"; labeljust=l; style=filled; fillcolor="#eaf5ea"; color="#4a9c4a";
    Onboarding [label="Organization Onboarding\n(Buyer / Seller)"];
    MyProfile [label=<<B>My Profile</B><BR/>(Buyer, Seller, Inspector)<BR/><I>Email verification / resend (if applicable)</I>>,penwidth=2];
    PublicProfile [label="Public User Profile\n(authenticated Buyer / Seller)"];
    {rank=same; Onboarding; MyProfile; PublicProfile;}
    Onboarding -> MyProfile [label="profile created"];
  }
  RegisterAccount -> Onboarding [label="auto sign-in"]; Login -> Onboarding [label="profile absent\n(Buyer / Seller)"];
  ListingDetail -> PublicProfile [label="sign-in required"];
  MainMenu [label="Main menu (authenticated; items depend on role and eligibility)",shape=box,style=filled,fillcolor="#e6d9f0",color="#9673A6",width=8];
  Login -> MainMenu [label="existing profile / staff"]; MyProfile -> MainMenu [label="role-based access"];
  subgraph cluster_cm {
    label="Contract & Milestone"; labeljust=l; style=filled; fillcolor="#eaf5ea"; color="#4a9c4a";
    MyContracts [label=<<B>My Contracts</B>>,penwidth=2]; CreateOffer [label="Create Offer (Buyer)"]; ContractDetail [label="Contract Detail"]; ReportBreachDialog [label="Report Breach Dialog",style="rounded,dashed,filled"];
    EditTerms [label="Edit Contract Terms"]; SignContract [label="Sign Contract"]; MilestoneDetail [label="Milestone Detail"]; ProposeReplacement [label="Propose Replacement\nContract"]; ExportEscrow [label="Export Escrow\nStatement"]; BreachCaseDetailParty [label=<Breach Case Detail<BR/>(Party View)<BR/><I>Terminate Contract</I>>]; OTPVerification [label="OTP Verification"];
    RecordWeighing [label="Record Weighing (Seller)"]; RecordReceipt [label="Record Receipt (Buyer)"]; RespondToFlag [label="Respond to Flag (Seller)"]; ClaimForceMajeure [label="Claim Force Majeure\n(Seller)"]; MilestonePriceAdj [label="Milestone Price\nAdjustment"];
    {rank=same; MyContracts; ContractDetail; CreateOffer; ReportBreachDialog;}
    {rank=same; EditTerms; SignContract; MilestoneDetail; ProposeReplacement; ExportEscrow; BreachCaseDetailParty;}
    {rank=same; RecordWeighing; RecordReceipt; RespondToFlag; ClaimForceMajeure; MilestonePriceAdj;}
    CreateOffer -> ContractDetail [dir=back]; MyContracts -> ContractDetail; ContractDetail -> {EditTerms SignContract MilestoneDetail ProposeReplacement ExportEscrow}; SignContract -> OTPVerification; MilestoneDetail -> {RecordWeighing RecordReceipt RespondToFlag ClaimForceMajeure MilestonePriceAdj}; ReportBreachDialog -> BreachCaseDetailParty;
  }
  MainMenu -> CreateOffer [label="Start an offer (Buyer)"];
  subgraph cluster_pc {
    label="Profile & Catalog"; labeljust=l; style=filled; fillcolor="#eaf5ea"; color="#4a9c4a";
    MyPlots [label=<<B>My Plots (Seller)</B><BR/><I>Import KML &#183; Add Plot by GPS<BR/>Pin &#183; Upload Cadastral Extract<BR/>&#183; Request Geo Re-evaluation</I>>,penwidth=2]; MyProducts [label=<<B>My Products (Seller)</B>>,penwidth=2]; MyListings [label=<<B>My Listings (Seller)</B>>,penwidth=2]; ListingForm [label="Listing Form (Seller)"];
    {rank=same; MyPlots; MyProducts; MyListings; ListingForm;} MyListings -> ListingForm;
  }
  subgraph cluster_insp {
    label="Inspector"; labeljust=l; style=filled; fillcolor="#fff6de"; color="#c9971f";
    AssignedCases [label=<<B>Assigned Cases</B>>,penwidth=2]; SubmitInspectionResult [label="Submit Inspection Result"]; {rank=same; AssignedCases; SubmitInspectionResult;} AssignedCases -> SubmitInspectionResult;
  }
  subgraph cluster_op {
    label="Operator"; labeljust=l; style=filled; fillcolor="#e4edfa"; color="#3063a8";
    KYCQueue [label=<<B>KYC Review Queue</B><BR/>(email verified; pending)>,penwidth=2]; KYCDetail [label=<KYC Detail<BR/><I>Verify KYC &#183; Reject KYC</I>>]; PlotRiskQueue [label=<<B>Plot Risk Review<BR/>Queue</B>>,penwidth=2]; CategoryModeration [label=<<B>Category &amp; Listing<BR/>Moderation</B>>,penwidth=2]; ManualPriceEntry [label=<<B>Manual Price Entry</B>>,penwidth=2]; ReputationRequestsOp [label=<<B>Reputation Action<BR/>Requests (Operator,<BR/>Arbitrator)</B><BR/><I>Propose Reputation Action</I>>,penwidth=2];
    {rank=same; KYCQueue; KYCDetail; PlotRiskQueue; CategoryModeration; ManualPriceEntry; ReputationRequestsOp;} KYCQueue -> KYCDetail;
    Level2Commissions [label=<<B>Level 2 Commissions</B>>,penwidth=2]; PendingExtReview [label=<<B>Pending External<BR/>Report Review</B>>,penwidth=2]; ManualExtUpload [label=<<B>Manual External Report<BR/>Upload</B>>,penwidth=2]; EmailIntakeFailOp [label=<<B>Email Intake Failures</B>>,penwidth=2]; ActivationFailOp [label=<<B>Activation Failures</B>>,penwidth=2]; MilestoneFundFailOp [label=<<B>Milestone Funding<BR/>Failures</B>>,penwidth=2];
    {rank=same; Level2Commissions; PendingExtReview; ManualExtUpload; EmailIntakeFailOp; ActivationFailOp; MilestoneFundFailOp;} KYCQueue -> Level2Commissions [style=invis];
  }
  subgraph cluster_arb {
    label="Arbitrator"; labeljust=l; style=filled; fillcolor="#efe3f5"; color="#9673A6";
    BreachCaseQueue [label=<<B>Breach Case Queue</B>>,penwidth=2]; BreachCaseDetailArb [label=<Breach Case Detail<BR/>(Arbitrator)<BR/><I>Request Inspection &#183; Resolve<BR/>Breach Case &#183; Terminate<BR/>Contract</I>>]; FMReviewQueue [label=<<B>Force Majeure Review<BR/>Queue</B>>,penwidth=2]; FMClaimDetail [label="Force Majeure Claim\nDetail"]; ReputationRequestsArb [label=<<B>Reputation Action<BR/>Requests</B><BR/><I>Approve / Reject</I>>,penwidth=2];
    {rank=same; BreachCaseQueue; BreachCaseDetailArb; FMReviewQueue; FMClaimDetail; ReputationRequestsArb;} BreachCaseQueue -> BreachCaseDetailArb; FMReviewQueue -> FMClaimDetail;
  }
  subgraph cluster_admin {
    label="Admin"; labeljust=l; style=filled; fillcolor="#fbe7e7"; color="#b33a3a";
    AuditChainStatus [label=<<B>Audit Chain<BR/>Verification Status</B>>,penwidth=2]; ContractEvidenceExport [label=<<B>Contract Evidence<BR/>Export</B>>,penwidth=2]; SecurityLockStatus [label=<<B>Security Lock Status</B>>,penwidth=2]; TermReportCommodity [label=<<B>Termination Report by<BR/>Commodity</B>>,penwidth=2]; EscrowEffReport [label=<<B>Escrow Effectiveness<BR/>Report</B>>,penwidth=2]; FMTrends [label=<<B>Force Majeure Trends</B>>,penwidth=2];
    {rank=same; AuditChainStatus; ContractEvidenceExport; SecurityLockStatus; TermReportCommodity; EscrowEffReport; FMTrends;}
  }
  // Invisible ordering links preserve the original group order without adding navigation.
  RecordWeighing -> MyPlots -> AssignedCases -> KYCQueue [style=invis]; Level2Commissions -> BreachCaseQueue -> AuditChainStatus [style=invis];
}
