<mxfile host="vpdiagram.py"><diagram name="bf04" id="bf04"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="990" pageHeight="1975"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane0" value="Buyer" style="swimlane;horizontal=1;startSize=32;fontStyle=1;fontFamily=Arial;fontSize=12;fillColor=none;strokeColor=#000000;swimlaneFillColor=#FFFFFF;html=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="170" height="1975" as="geometry"/></mxCell><mxCell id="lane1" value="Seller" style="swimlane;horizontal=1;startSize=32;fontStyle=1;fontFamily=Arial;fontSize=12;fillColor=none;strokeColor=#000000;swimlaneFillColor=#FFFFFF;html=1;" vertex="1" parent="1"><mxGeometry x="170" y="0" width="170" height="1975" as="geometry"/></mxCell><mxCell id="lane2" value="Arbitrator" style="swimlane;horizontal=1;startSize=32;fontStyle=1;fontFamily=Arial;fontSize=12;fillColor=none;strokeColor=#000000;swimlaneFillColor=#FFFFFF;html=1;" vertex="1" parent="1"><mxGeometry x="340" y="0" width="150" height="1975" as="geometry"/></mxCell><mxCell id="lane3" value="Inspector" style="swimlane;horizontal=1;startSize=32;fontStyle=1;fontFamily=Arial;fontSize=12;fillColor=none;strokeColor=#000000;swimlaneFillColor=#FFFFFF;html=1;" vertex="1" parent="1"><mxGeometry x="490" y="0" width="150" height="1975" as="geometry"/></mxCell><mxCell id="lane4" value="System" style="swimlane;horizontal=1;startSize=32;fontStyle=1;fontFamily=Arial;fontSize=12;fillColor=none;strokeColor=#000000;swimlaneFillColor=#FFFFFF;html=1;" vertex="1" parent="1"><mxGeometry x="640" y="0" width="350" height="1975" as="geometry"/></mxCell><mxCell id="start" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="793.0" y="43.0" width="24" height="24" as="geometry"/></mxCell><mxCell id="a1" value="1. Funding date due: request&lt;br&gt;the lock of the Buyer&#x27;s payment&lt;br&gt;(each milestone runs alone)" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="685.0" y="83.5" width="240" height="63.0" as="geometry"/></mxCell><mxCell id="d1" value="" style="rhombus;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="790.0" y="170.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="a2" value="2. Stay CREATED; notify the&lt;br&gt;parties; retry or BF-05&lt;br&gt;recovery" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="685.0" y="223.5" width="240" height="63.0" as="geometry"/></mxCell><mxCell id="f1" value="" style="ellipse;shape=endState;fillColor=#000000;strokeColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="242.0" y="317.0" width="26" height="26" as="geometry"/></mxCell><mxCell id="f1_name" value="Continues in BF-05" style="text;strokeColor=none;fillColor=none;align=center;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="203.625" y="349.0" width="102.75" height="15.0" as="geometry"/></mxCell><mxCell id="a3" value="3. Deliver; declare&lt;br&gt;the weight with&lt;br&gt;READY evidence&lt;br&gt;and consent" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="180.0" y="146.0" width="150" height="78.0" as="geometry"/></mxCell><mxCell id="n1" value="Correction within&lt;br&gt;1 h of the first&lt;br&gt;declaration, before&lt;br&gt;Buyer receipt" style="shape=note;size=10;align=left;spacingLeft=8;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="10.0" y="147.0" width="150" height="76.0" as="geometry"/></mxCell><mxCell id="a4" value="4. Record the&lt;br&gt;received weight&lt;br&gt;with READY evidence&lt;br&gt;and consent" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="10.0" y="251.0" width="150" height="78.0" as="geometry"/></mxCell><mxCell id="a5" value="5. BUYER_RECEIVED: freeze&lt;br&gt;the seller weight, open the&lt;br&gt;confirmation window; request&lt;br&gt;Level 1.5 if it is mandatory" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="685.0" y="371.0" width="240" height="78.0" as="geometry"/></mxCell><mxCell id="fork" value="" style="shape=line;strokeWidth=6;strokeColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="735.0" y="477.0" width="140" height="6" as="geometry"/></mxCell><mxCell id="dB" value="" style="rhombus;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="70.0" y="520.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="a6" value="6. Confirm clean&lt;br&gt;receipt with&lt;br&gt;explicit consent" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="15.0" y="568.5" width="140" height="63.0" as="geometry"/></mxCell><mxCell id="a8" value="8. Clean confirmation or Buyer&lt;br&gt;timeout: settle only when the&lt;br&gt;inspection guard passes" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="685.0" y="568.5" width="240" height="63.0" as="geometry"/></mxCell><mxCell id="a7" value="7. Flag QUANTITY&lt;br&gt;or QUALITY with&lt;br&gt;evidence, consent" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="15.0" y="673.5" width="140" height="63.0" as="geometry"/></mxCell><mxCell id="a9" value="9. AWAITING_SELLER_RESPONSE:&lt;br&gt;no money or reputation effect" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="685.0" y="681.0" width="240" height="48.0" as="geometry"/></mxCell><mxCell id="dC" value="" style="rhombus;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="790.0" y="760.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="dC2" value="" style="rhombus;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="240.0" y="760.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="a10" value="10. Contest the&lt;br&gt;flag with consent" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="180.0" y="826.0" width="150" height="48.0" as="geometry"/></mxCell><mxCell id="a12" value="12. Dispute exit&lt;br&gt;(either party):&lt;br&gt;concede, retract or&lt;br&gt;settle; consent,&lt;br&gt;step-up, OTP" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="15.0" y="823.5" width="140" height="93.0" as="geometry"/></mxCell><mxCell id="a11" value="11. Seller silent: QUANTITY →&lt;br&gt;Buyer weight, no fault;&lt;br&gt;QUALITY → system contests" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="685.0" y="823.5" width="240" height="63.0" as="geometry"/></mxCell><mxCell id="dD" value="" style="rhombus;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="790.0" y="910.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="mC" value="" style="rhombus;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="240.0" y="970.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="m13" value="" style="rhombus;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="790.0" y="970.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="a13" value="13. Request a Level 1.5&lt;br&gt;inspection (a contest opens&lt;br&gt;a BreachCase)" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="685.0" y="1018.5" width="240" height="63.0" as="geometry"/></mxCell><mxCell id="a14" value="14. Inspect the&lt;br&gt;goods; submit&lt;br&gt;the report" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="500.0" y="1018.5" width="130" height="63.0" as="geometry"/></mxCell><mxCell id="a15" value="15. Evaluate the confirmed report&lt;br&gt;(INCONCLUSIVE twice: funds&lt;br&gt;stay locked, Operator alerted)" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="685.0" y="1113.5" width="240" height="63.0" as="geometry"/></mxCell><mxCell id="dE" value="" style="rhombus;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="790.0" y="1200.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="a16" value="16. COMPLETE: compute the&lt;br&gt;quantity and quality" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="685.0" y="1261.0" width="240" height="48.0" as="geometry"/></mxCell><mxCell id="dF" value="" style="rhombus;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="790.0" y="1335.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="a17" value="17. Review and&lt;br&gt;approve the&lt;br&gt;computed&lt;br&gt;resolution" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="350.0" y="1311.0" width="130" height="78.0" as="geometry"/></mxCell><mxCell id="dG" value="" style="rhombus;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="400.0" y="1420.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="a18" value="18. The party at&lt;br&gt;fault may contest&lt;br&gt;once within 2&lt;br&gt;business days" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="180.0" y="1396.0" width="150" height="78.0" as="geometry"/></mxCell><mxCell id="dH" value="" style="rhombus;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="240.0" y="1510.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="m19" value="" style="rhombus;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="400.0" y="1510.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="a19" value="19. Finalize the settlement or&lt;br&gt;remedy (quality concession:&lt;br&gt;fault; quantity: no fault)" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="685.0" y="1493.5" w