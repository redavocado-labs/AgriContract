<mxfile host="app.diagrams.net"><diagram id="bf04" name="BF-04"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1500" pageHeight="2000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane0" value="Buyer" style="swimlane;horizontal=1;startSize=44;rounded=0;fillColor=#FFFFFF;swimlaneFillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=20;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="260" height="2000" as="geometry"/></mxCell><mxCell id="lane1" value="Seller" style="swimlane;horizontal=1;startSize=44;rounded=0;fillColor=#FFFFFF;swimlaneFillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=20;" vertex="1" parent="1"><mxGeometry x="260" y="0" width="260" height="2000" as="geometry"/></mxCell><mxCell id="lane2" value="Arbitrator" style="swimlane;horizontal=1;startSize=44;rounded=0;fillColor=#FFFFFF;swimlaneFillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=20;" vertex="1" parent="1"><mxGeometry x="520" y="0" width="230" height="2000" as="geometry"/></mxCell><mxCell id="lane3" value="Inspector" style="swimlane;horizontal=1;startSize=44;rounded=0;fillColor=#FFFFFF;swimlaneFillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=20;" vertex="1" parent="1"><mxGeometry x="750" y="0" width="230" height="2000" as="geometry"/></mxCell><mxCell id="lane4" value="System" style="swimlane;horizontal=1;startSize=44;rounded=0;fillColor=#FFFFFF;swimlaneFillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=20;" vertex="1" parent="1"><mxGeometry x="980" y="0" width="520" height="2000" as="geometry"/></mxCell><mxCell id="start" value="" style="ellipse;fillColor=#000000;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fontSize=18;" vertex="1" parent="1"><mxGeometry x="1225" y="60" width="30" height="30" as="geometry"/></mxCell><mxCell id="fund" value="1. Funding date due: request and lock payment&lt;br&gt;Each milestone runs independently" style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fontSize=18;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1010" y="110" width="460" height="72" as="geometry"/></mxCell><mxCell id="funded" value="" style="rhombus;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fontSize=18;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1222" y="202" width="36" height="36" as="geometry"/></mxCell><mxCell id="recover" value="2. If funding fails: remain CREATED; notify parties&lt;br&gt;Retry / applicable BF-05 recovery" style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fontSize=18;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1010" y="255" width="460" height="62" as="geometry"/></mxCell><mxCell id="weigh" value="3. Deliver and declare&lt;br&gt;weight with READY&lt;br&gt;evidence and consent" style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fontSize=18;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="280" y="255" width="220" height="90" as="geometry"/></mxCell><mxCell id="wn" value="Correction within 1 hour&lt;br&gt;of first declaration,&lt;br&gt;before Buyer receipt" style="shape=note;size=12;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fontSize=18;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="280" y="370" width="220" height="77" as="geometry"/></mxCell><mxCell id="receive" value="4. Record received&lt;br&gt;weight with READY&lt;br&gt;evidence and consent" style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fontSize=18;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="20" y="475" width="220" height="90" as="geometry"/></mxCell><mxCell id="received" value="5. BUYER_RECEIVED; freeze seller weight&lt;br&gt;Start confirmation window; request Level 1.5&lt;br&gt;if mandatory inspection applies" style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fontSize=18;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1010" y="475" width="460" height="80" as="geometry"/></mxCell><mxCell id="buyerchoice" value="" style="rhombus;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fontSize=18;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="112" y="590" width="36" height="36" as="geometry"/></mxCell><mxCell id="confirm" value="6. Confirm clean receipt&lt;br&gt;with explicit consent" style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fontSize=18;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="20" y="660" width="220" height="78" as="geometry"/></mxCell><mxCell id="flag" value="7. Flag QUANTITY or&lt;br&gt;QUALITY with evidence&lt;br&gt;and consent" style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fontSize=18;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="20" y="780" width="220" height="80" as="geometry"/></mxCell><mxCell id="clean" value="8. Clean confirmation or Buyer timeout&lt;br&gt;Only settle when inspection guard passes" style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fontSize=18;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1010" y="660" width="460" height="80" as="geometry"/></mxCell><mxCell id="await" value="9. AWAITING_SELLER_RESPONSE&lt;br&gt;No money or reputation consequence" style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fontSize=18;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1010" y="780" width="460" height="60" as="geometry"/></mxCell><mxCell id="respond" value="10. Contest flag&lt;br&gt;with consent" style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fontSize=18;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="280" y="900" width="220" height="70" as="geometry"/></mxCell><mxCell id="silence" value="11. Seller timeout: QUANTITY → Buyer weight&lt;br&gt;(no fault); QUALITY → system contests" style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fontSize=18;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1010" y="900" width="460" height="80" as="geometry"/></mxCell><mxCell id="exit" value="12. Eligible dispute exit (either party):&lt;br&gt;concede / retract flag or mutual settlement&lt;br&gt;Consent + step-up + OTP; only before eligible cutoff" style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fontSize=18;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="20" y="1010" width="480" height="86" as="geometry"/></mxCell><mxCell id="request" value="13. Request Level 1.5 inspection&lt;br&gt;Contest opens BreachCase; mandatory inspection&lt;br&gt;may already be in progress" style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fontSize=18;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1010" y="1040" width="460" height="82" as="geometry"/></mxCell><mxCell id="inspect" value="14. Inspect goods&lt;br&gt;and submit report" style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fontSize=18;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="765" y="1170" width="200" height="80" as="geometry"/></mxCell><mxCell id="report" value="15. Evaluate confirmed report&lt;br&gt;INCONCLUSIVE: retry once if allowed; otherwise&lt;br&gt;hold funds and alert Operator" style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fontSize=18;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1010" y="1170" width="460" height="90" as="geometry"/></mxCell><mxCell id="compute" value="16. COMPLETE: compute quantity and quality&lt;br&gt;Mandatory + CONFORMING without dispute → settle;&lt;br&gt;otherwise attach computed resolution to case" style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fontSize=18;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1010" y="1300" width="460" height="85" as="geometry"/></mxCell><mxCell id="review" value="17. Review / approve&lt;br&gt;computed resolution" style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fontSize=18;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="535" y="1420" width="200" height="75" as="geometry"/></mxCell><mxCell id="contest" value="18. Contest once within&lt;br&gt;2 business days if&lt;br&gt;first NON_CONFORMING&lt;br&gt;decision attributes fault" style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fontSize=18;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="280" y="1540" width="220" height="85" as="geometry"/></mxCell><mxCell id="final" value="19. Finalize settlement or remedy&lt;br&gt;After contest window expires, or final review;&lt;br&gt;quality concession: fault; quantity concession: no fault" style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fontSize=18;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1010" y="1540" width="460" height="86" as="geometry"/></mxCell><mxCell id="settled" value="20. Milestone SETTLED; execute money legs&lt;br&gt;If last milestone: create deposit-return remedy&lt;br&gt;once, in same settlement transaction" style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fontSize=18;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1010" y="1670" width="460" height="75" as="geometry"/></mxCell><mxCell id="guard" value="21. All milestones settled AND escrow clearance?&lt;br&gt;No pending/failed remedy legs; zero remaining lock;&lt;br&gt;matching terminal decision cleared" style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fontSize=18;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1010" y="1780" width="460" height="85" as="geometry"/></mxCell><mxCell id="pending" value="Remain ACTIVE; other milestones run independently.&lt;br&gt;If all settled, await clearance or recover failed legs." style="shape=note;size=12;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fontSize=18;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="535" y="1780" width="420" height="85" as="geometry"/></mxCell><mxCell id="end" value="" style="ellipse;shape=doubleEllipse;fillColor=#000000;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fontSize=18;" vertex="1" parent="1"><mxGeometry x="1225" y="1915" width="30" height="30" as="geometry"/></mxCell><mxCell id="endnote" value="Contract SETTLED" style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fontSize=18;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1010" y="1952" width="460" height="34" as="geometry"/></mxCell><mxCell id="e0" style="edgeStyle=none;rounded=0;html=1;endArrow=open;endSize=8;strokeColor=#000000;fontColor=#000000;fontSize=15;exitX=0.5000;exitY=1.0000;entryX=0.5000;entryY=0.0000;" edge="1" parent="1" source="start" target="fund"><mxGeometry relative="1" as="geometry"><Array as="points"/></mxGeometry></mxCell><mxCell id="e1" style="edgeStyle=none;rounded=0;html=1;endArrow=open;endSize=8;strokeColor=#000000;fontColor=#000000;fontSize=15;exitX=0.5000;exitY=1.0000;entryX=0.5000;entryY=0.0000;" edge="1" parent="1" source="fund" target="funded"><mxGeometry relative="1" as="geometry"><Array as="points"/></mxGeometry></mxCell><mxCell id="e2" style="edgeStyle=none;rounded=0;html=1;endArrow=open;endSize=8;strokeColor=#000000;fontColor=#000000;fontSize=15;exitX=0.5000;exitY=1.0000;entryX=0.5000;entryY=0.0000;" edge="1" parent="1" source="funded" target="recover"><mxGeometry relative="1" as="geometry"><Array as="points"/></mxGeometry></mxCell><mxCell id="e2l" value="[no]" style="text;html=1;strokeColor=none;fillColor=#FFFFFF;fontSize=15;align=center;" vertex="1" parent="1"><mxGeometry x