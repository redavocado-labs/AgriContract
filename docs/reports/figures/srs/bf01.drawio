ments and&lt;br&gt;representative authority" style="fontFamily=Arial;fontSize=14;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="320" y="455" width="230" height="60" as="geometry" /></mxCell><mxCell id="decision" value="" style="fontFamily=Arial;fontSize=14;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;shape=rhombus;" vertex="1" parent="1"><mxGeometry x="400" y="550" width="70" height="48" as="geometry" /></mxCell><mxCell id="approve" value="Verify KYC and record&lt;br&gt;authorization expiry&lt;br&gt;or indefinite authorization" style="fontFamily=Arial;fontSize=14;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="320" y="635" width="230" height="64" as="geometry" /></mxCell><mxCell id="approved" value="Set VERIFIED; email result;&lt;br&gt;allow trading if eligible" style="fontFamily=Arial;fontSize=14;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="610" y="635" width="230" height="64" as="geometry" /></mxCell><mxCell id="end1" value="" style="fontFamily=Arial;fontSize=14;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;shape=endState;fillColor=#000000;" vertex="1" parent="1"><mxGeometry x="713" y="730" width="24" height="24" as="geometry" /></mxCell><mxCell id="reject" value="Reject with reason" style="fontFamily=Arial;fontSize=14;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="320" y="795" width="230" height="52" as="geometry" /></mxCell><mxCell id="rejected" value="Set REJECTED;&lt;br&gt;email rejection reason" style="fontFamily=Arial;fontSize=14;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry x="610" y="795" width="230" height="52" as="geometry" /></mxCell><mxCell id="end2" value="" 