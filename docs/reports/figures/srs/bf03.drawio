        </mxCell>
        <mxCell id="a1" value="1. Create an offer&lt;br&gt;on an eligible listing" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=14;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="14.5" y="134.68" width="232.0" height="71.04" as="geometry"/>
        </mxCell>
        <mxCell id="a2" value="2. Validate eligibility and&lt;br&gt;terms; reserve the listing&lt;br&gt;quantity" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=14;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="572.75" y="123.58" width="362.5" height="93.24" as="geometry"/>
        </mxCell>
        <mxCell id="a3" value="3. Review or revise&lt;br&gt;the terms (either&lt;br&gt;party, before the&lt;br&gt;first signature)" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=14;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="271.88" y="238.28" width="239.25" height="115.44" as="geometry"/>
        </mxCell>
        <mxCell id="a4" value="4. Withdraw the offer&lt;br&gt;(either party, before&lt;br&gt;the second signature)" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=14;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="271.88" y="456.58" width="239.25" height="93.24" as="geometry"/>
        </mxCell>
        <mxCell id="a5" value="5. Mark WITHDRAWN, release&lt;br&gt;the reservation, notify&lt;br&gt;the other party" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=14;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="572.75" y="456.58" width="362.5" height="93.24" as="geometry"/>
        </mxCell>
        <mxCell id="a6" value="7. Buyer signs:&lt;br&gt;consent, step-up&lt;br&gt;login, e-mail OTP" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=14;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="14.5" y="745.18" width="232.0" height="93.24" as="geometry"/>
        </mxCell>
        <mxCell id="a7" value="8. Seller signs:&lt;br&gt;consent, step-up&lt;br&gt;login, e-mail OTP" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=14;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="275.5" y="745.18" width="232.0" height="93.24" as="geometry"/>
        </mxCell>
        <mxCell id="a8" value="9. Recheck both parties'&lt;br&gt;eligibility, the same terms&lt;br&gt;fingerprint and the funding&lt;br&gt;schedule" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=14;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="572.75" y="919.08" width="362.5" height="115.44" as="geometry"/>
        </mxCell>
        <mxCell id="r1" value="Reject the&lt;br&gt;signature; retry&lt;br&gt;or withdraw" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=14;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="877.25" y="1048.58" width="159.5" height="93.24" as="geometry"/>
        </mxCell>
        <mxCell id="a9" value="10. Record the second&lt;br&gt;signature (SIGNED)" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=14;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="572.75" y="1178.08" width="362.5" height="71.04" as="geometry"/>
        </mxCell>
        <mxCell id="a10" value="11. Lock the required deposits&lt;br&gt;(automatic retries)" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=14;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="572.75" y="1289.08" width="362.5" height="71.04" as="geometry"/>
        </mxCell>
        <mxCell id="a11" value="12. ACTIVE: finalize the reservation,&lt;br&gt;invalidate cancel requests;&lt;br&gt;continue with BF-04" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=14;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="558.25" y="1499.98" width="391.5" height="93.24" as="geometry"/>
        </mxCell>
        <mxCell id="a12" value="14. Stay SIGNED; notify both&lt;br&gt;parties and the Operator" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=14;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="572.75" y="1673.88" width="362.5" height="71.04" as="geometry"/>
        </mxCell>
        <mxCell id="a13" value="15. Fix the technical&lt;br&gt;cause; retry only the&lt;br&gt;missing legs" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=14;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1">
