        </mxCell>
        <mxCell id="a14" value="16. Either party asks&lt;br&gt;to cancel: consent,&lt;br&gt;step-up, e-mail OTP" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=14;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="271.88" y="1766.38" width="239.25" height="93.24" as="geometry"/>
        </mxCell>
        <mxCell id="a15" value="17. Check: both asked, or one&lt;br&gt;request standing 5 business days&lt;br&gt;after the first lock failure" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=14;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1">
