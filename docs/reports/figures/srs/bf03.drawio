        </mxCell>
        <mxCell id="w1" value="Wait; a party may&lt;br&gt;withdraw its own&lt;br&gt;request before&lt;br&gt;refunds begin" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=14;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1">
