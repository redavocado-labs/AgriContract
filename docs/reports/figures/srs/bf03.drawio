1"><mxGeometry x="530" y="854" width="380" height="74" as="geometry"/></mxCell><mxCell id="enda" value="" style="ellipse;shape=doubleEllipse;fillColor=#000000;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fontSize=18;" vertex="1" parent="1"><mxGeometry x="705" y="943" width="30" height="30" as="geometry"/></mxCell><mxCell id="failure" value="12. Remain SIGNED; notify&lt;br&gt;both parties and Operator" style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fontSize=18;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="530" y="995" width="380" height="62" as="geometry"/></mxCell><mxCell id="recover" value="" style="rhombus;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fontSize=18;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="703" y="1080" width="34" height="34" as="geometry"/></mxCell><mxCell id="retry" value="13. Fix technical cause;&lt;br&gt;retry missing legs only" style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fontSize=18;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="970" y="1060" width="215" height="72" as="geometry"/></mxCell><mxCell id="cancel" value="14. Either party requests&lt;br&gt;cancellation: consent,&lt;br&gt;step-up and email OTP" style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fontSize=18;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="262" y="1060" width="210" height="90" as="geometry"/></mxCell><mxCell id="eligible" value="15. Both request, or one request&lt;br&gt;remains 5 business days after&lt;br&gt;first lock failure?" style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;strokeColor=#000000;fontColor=#000000;fontSize=18;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="530" y="1170" width="380" height="76" as="geometry"/></mxCell><mxCell id="wait" value="Wait; either party may&lt;br&gt;withdraw own request&lt;br&gt;before refunds begin" style="rounded=1;arcSi