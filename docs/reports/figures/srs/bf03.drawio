<mxfile host="vpdiagram.py"><diagram name="bf03" id="bf03"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="910" pageHeight="1665"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane0" value="Buyer" style="swimlane;horizontal=1;startSize=32;fontStyle=1;fontFamily=Arial;fontSize=12;fillColor=none;strokeColor=#000000;swimlaneFillColor=#FFFFFF;html=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="180" height="1665" as="geometry"/></mxCell><mxCell id="lane1" value="Seller" style="swimlane;horizontal=1;startSize=32;fontStyle=1;fontFamily=Arial;fontSize=12;fillColor=none;strokeColor=#000000;swimlaneFillColor=#FFFFFF;html=1;" vertex="1" parent="1"><mxGeometry x="180" y="0" width="180" height="1665" as="geometry"/></mxCell><mxCell id="lane2" value="System" style="swimlane;horizontal=1;startSize=32;fontStyle=1;fontFamily=Arial;fontSize=12;fillColor=none;strokeColor=#000000;swimlaneFillColor=#FFFFFF;html=1;" vertex="1" parent="1"><mxGeometry x="360" y="0" width="360" height="1665" as="geometry"/></mxCell><mxCell id="lane3" value="Operator" style="swimlane;horizontal=1;startSize=32;fontStyle=1;fontFamily=Arial;fontSize=12;fillColor=none;strokeColor=#000000;swimlaneFillColor=#FFFFFF;html=1;" vertex="1" parent="1"><mxGeometry x="720" y="0" width="190" height="1665" as="geometry"/></mxCell><mxCell id="start" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="78.0" y="43.0" width="24" height="24" as="geometry"/></mxCell><mxCell id="a1" value="1. Create an offer&lt;br&gt;on an eligible listing" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="10.0" y="91.0" width="160" height="48.0" as="geometry"/></mxCell><mxCell id="a2" value="2. Validate eligibility and&lt;br&gt;terms; reserve the listing&lt;br&gt;quantity" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="395.0" y="83.5" width="250" height="63.0" as="geometry"/></mxCell><mxCell id="a3" value="3. Review or revise&lt;br&gt;the terms (either&lt;br&gt;party, before the&lt;br&gt;first signature)" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="187.5" y="161.0" width="165" height="78.0" as="geometry"/></mxCell><mxCell id="d1" value="" style="rhombus;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="255.0" y="260.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="a4" value="4. Withdraw the offer&lt;br&gt;(either party, before&lt;br&gt;the second signature)" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="187.5" y="308.5" width="165" height="63.0" as="geometry"/></mxCell><mxCell id="a5" value="5. Mark WITHDRAWN, release&lt;br&gt;the reservation, notify&lt;br&gt;the other party" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="395.0" y="308.5" width="250" height="63.0" as="geometry"/></mxCell><mxCell id="f1" value="" style="ellipse;shape=endState;fillColor=#000000;strokeColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="257.0" y="402.0" width="26" height="26" as="geometry"/></mxCell><mxCell id="f1_name" value="Offer withdrawn" style="text;strokeColor=none;fillColor=none;align=center;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="228.080078125" y="434.0" width="83.83984375" height="15.0" as="geometry"/></mxCell><mxCell id="fork" value="" style="shape=line;strokeWidth=6;strokeColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="30.0" y="477.0" width="300" height="6" as="geometry"/></mxCell><mxCell id="a6" value="6. Buyer signs:&lt;br&gt;consent, step-up&lt;br&gt;login, e-mail OTP" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="10.0" y="503.5" width="160" height="63.0" as="geometry"/></mxCell><mxCell id="a7" value="7. Seller signs:&lt;br&gt;consent, step-up&lt;br&gt;login, e-mail OTP" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="190.0" y="503.5" width="160" height="63.0" as="geometry"/></mxCell><mxCell id="n1" value="Either party may sign first;&lt;br&gt;eligibility is rechecked at&lt;br&gt;initiate and at verify (D37)" style="shape=note;size=10;align=left;spacingLeft=8;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="412.5" y="504.5" width="215" height="61.0" as="geometry"/></mxCell><mxCell id="join" value="" style="shape=line;strokeWidth=6;strokeColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="30.0" y="597.0" width="300" height="6" as="geometry"/></mxCell><mxCell id="a8" value="8. Recheck both parties&#x27;&lt;br&gt;eligibility, the same terms&lt;br&gt;fingerprint and the funding&lt;br&gt;schedule (D67)" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="395.0" y="621.0" width="250" height="78.0" as="geometry"/></mxCell><mxCell id="d2" value="" style="rhombus;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="505.0" y="725.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="r1" value="Reject the&lt;br&gt;signature; retry&lt;br&gt;or withdraw" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="605.0" y="708.5" width="110" height="63.0" as="geometry"/></mxCell><mxCell id="a9" value="9. Record the second&lt;br&gt;signature (SIGNED)" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="395.0" y="796.0" width="250" height="48.0" as="geometry"/></mxCell><mxCell id="a10" value="10. Lock the required deposits&lt;br&gt;(automatic retries)" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="395.0" y="871.0" width="250" height="48.0" as="geometry"/></mxCell><mxCell id="d3" value="" style="rhombus;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="505.0" y="950.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="a11" value="11. ACTIVE: finalize the reservation,&lt;br&gt;invalidate cancel requests;&lt;br&gt;continue with BF-04" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="385.0" y="1013.5" width="270" height="63.0" as="geometry"/></mxCell><mxCell id="f2" value="" style="ellipse;shape=endState;fillColor=#000000;strokeColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="77.0" y="1032.0" width="26" height="26" as="geometry"/></mxCell><mxCell id="f2_name" value="Contract active" style="text;strokeColor=none;fillColor=none;align=center;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="49.97265625" y="1064.0" width="80.0546875" height="15.0" as="geometry"/></mxCell><mxCell id="a12" value="12. Stay SIGNED; notify both&lt;br&gt;parties and the Operator" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="395.0" y="1111.0" width="250" height="48.0" as="geometry"/></mxCell><mxCell id="d4" value="" style="rhombus;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="505.0" y="1190.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="a13" value="13. Fix the technical&lt;br&gt;cause; retry only the&lt;br&gt;missing legs" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="732.5" y="1173.5" width="165" height="63.0" as="geometry"/></mxCell><mxCell id="n2" value="Retrying does not reset&lt;br&gt;the 5-business-day&lt;br&gt;window; a late lock&lt;br&gt;success still gives&lt;br&gt;ACTIVE" style="shape=note;size=10;align=left;spacingLeft=8;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="732.5" y="1259.5" width="165" height="91.0" as="geometry"/></mxCell><mxCell id="a14" value="14. Either party asks&lt;br&gt;to cancel: consent,&lt;br&gt;step-up, e-mail OTP" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="187.5" y="1173.5" width="165" height="63.0" as="geometry"/></mxCell><mxCell id="a15" value="15. Check: both asked, or one&lt;br&gt;request standing 5 business days&lt;br&gt;after the first lock failure" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="390.0" y="1268.5" width="260" height="63.0" as="geometry"/></mxCell><mxCell id="d5" value="" style="rhombus;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="505.0" y="1360.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="w1" value="Wait; a party may&lt;br&gt;withdraw its own&lt;br&gt;request before&lt;br&gt;refunds begin" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="10.0" y="1336.0" width="160" height="78.0" as="geometry"/></mxCell><mxCell id="a16" value="16. ACTIVATION_REFUND_PENDING:&lt;br&gt;stop lock retries, return every&lt;br&gt;locked deposit to its owner" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="390.0" y="1423.5" width="260" height="63.0" as="geometry"/></mxCell><mxCell id="d6" value="" style="rhombus;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="505.0" y="1515.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="x1" value="Alert the Operator;&lt;br&gt;the contract stays&lt;br&gt;pending" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="732.5" y="1498.5" width="165" height="63.0" as="geometry"/></mxCell><mxCell id="a17" value="17. Zero lock: ACTIVATION_FAILED,&lt;br&gt;release the reservation" style="rounded=1;arcSize=20;fontFamily=Arial;fontSize=12;strokeColor=#000000;fillColor=#FFFFFF;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="390.0" y="1576.0" width="260" height="48.0" as="geometry"/></mxCell><mxCell id="f3" value="" style="ellipse;shape=endState;fillColor=#000000;strokeColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="257.0" y="1587.0" width="26" height="26" as="geometry"/></mxCell><mxCell id="f3_name" value="Activation failed" style="text;strokeColor=none;fillColor=none;align=center;fontFamily=Arial;fontS